/android/app/release

# Seed data tooling — never commit real Firebase credentials
seed_data/serviceAccountKey.json
seed_data/node_modules/

# Generated localization code (regenerated by `flutter gen-l10n` via the
# `generate: true` flag in pubspec.yaml) — keep app_en.arb/app_tl.arb as
# the source of truth, not these.
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_en.dart
lib/l10n/app_localizations_tl.dart
