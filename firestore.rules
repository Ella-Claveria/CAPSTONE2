rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Active, or suspended for a set time that has already passed (the
    // account is marked active again by liftExpiredSuspensions in
    // functions/suspension.js, within a few minutes).
    function activeAccount(uid) {
      return exists(userPath(uid)) && (
        get(userPath(uid)).data.get('accountStatus', 'active') == 'active' ||
        (get(userPath(uid)).data.get('accountStatus', 'active') == 'suspended' &&
          get(userPath(uid)).data.get('suspendedUntil', null) is timestamp &&
          get(userPath(uid)).data.suspendedUntil <= request.time)
      );
    }

    function isAdmin() {
      return signedIn() && activeAccount(request.auth.uid) &&
        get(userPath(request.auth.uid)).data.role == 'admin' &&
        (request.auth.token.email_verified == true ||
          request.auth.token.email == 'admin@agritrade.com') &&
        adminSessionNotRevoked(request.auth.uid);
    }

    // Active Sessions > Revoke Session sets sessionsValidAfter on the
    // Admin's users/{uid} (functions/admin_session.js): a browser signed in
    // before it — the one signed out — is refused at once, without waiting
    // for its token to expire.
    function adminSessionNotRevoked(uid) {
      return get(userPath(uid)).data.get('sessionsValidAfter', null) == null ||
        request.auth.token.auth_time * 1000 >=
          get(userPath(uid)).data.sessionsValidAfter.toMillis();
    }

    function isBuyer() {
      return emailVerified() && activeAccount(request.auth.uid) &&
        get(userPath(request.auth.uid)).data.role == 'buyer';
    }

    function isApprovedFarmer() {
      return emailVerified() && activeAccount(request.auth.uid) &&
        get(userPath(request.auth.uid)).data.role == 'farmer' &&
        get(userPath(request.auth.uid)).data.get('approvalStatus', 'pending') == 'approved';
    }

    function approvedFarmer(uid) {
      return activeAccount(uid) &&
        get(userPath(uid)).data.role == 'farmer' &&
        get(userPath(uid)).data.get('approvalStatus', 'pending') == 'approved';
    }

    function canReserveProductStock(productId) {
      let orderId = request.resource.data.get('lastOrderId', '');
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let before = resource.data.get('quantity', 0);
      let after = request.resource.data.get('quantity', 0);
      return orderId is string && orderId.size() > 0 &&
        after >= 0 &&
        existsAfter(orderPath) &&
        getAfter(orderPath).data.buyerId == request.auth.uid &&
        getAfter(orderPath).data.productId == productId &&
        getAfter(orderPath).data.sellerId == resource.data.farmerId &&
        getAfter(orderPath).data.status == 'pending' &&
        getAfter(orderPath).data.quantity == before - after;
    }

    function marketplaceUser() {
      return isAdmin() || isBuyer() || isApprovedFarmer();
    }

    // The account passed the email code check (see functions/email_otp.js).
    function emailOtpVerified(uid) {
      let path = /databases/$(database)/documents/emailVerifications/$(uid);
      return exists(path) && get(path).data.verified == true;
    }

    // ---- Email verification codes ----
    // Issued and checked only by the requestEmailOtp / verifyEmailOtp Cloud
    // Functions (Admin SDK bypasses these rules). No client access at all,
    // not even to an account's own record: it holds the hash of a 6-digit
    // code, which is only safe while it cannot be read.
    match /emailVerifications/{userId} {
      allow read, write: if false;
    }

    // ---- Email change codes ----
    // The same, for the code sent to an Admin's new email by the
    // requestEmailChangeOtp / confirmEmailChangeOtp Cloud Functions.
    match /emailChangeVerifications/{userId} {
      allow read, write: if false;
    }

    // ---- Failed-login cooldown ----
    // Counted and enforced only by the checkLoginAllowed / reportLoginFailure
    // / clearLoginFailures Cloud Functions (Admin SDK). No client access, so
    // the app cannot reset or read its own count.
    match /loginThrottles/{emailHash} {
      allow read, write: if false;
    }

    // ---- Products ----
    match /products/{productId} {
      allow read: if marketplaceUser();
      // A farmer under a confirmed-violation suspension/ban may not create
      // new listings — see Moderation Queue (accountStatus on users/{uid}).
      // Only an Approved farmer may create a listing at all — the Flutter
      // app already keeps a Pending/Rejected farmer out of Add Product via
      // routing (AuthRoutingService), but that's a client-side convenience,
      // not a security boundary; this is what actually stops a direct API
      // call from a farmer who never got approved (missing approvalStatus
      // defaults to 'pending', same "not approved" convention used
      // everywhere else in this app).
      allow create: if isApprovedFarmer() &&
        request.auth.uid == request.resource.data.farmerId &&
        request.resource.data.isSuspended == false;
      // The owning farmer can edit their own listing; an admin may also
      // update (never delete) a listing — this is what backs Moderation
      // Queue's Hide/Remove Listing actions (isSuspended toggle).
      allow update: if isAdmin() ||
        (isApprovedFarmer() && request.auth.uid == resource.data.farmerId &&
          request.resource.data.farmerId == resource.data.farmerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'category', 'commodity', 'unit', 'price', 'retailPrice',
            'wholesaleEnabled', 'wholesalePrice', 'wholesaleMinimumQuantity',
            'retailMaximumQuantity', 'quantity', 'harvestDate', 'description', 'imageUrls',
            'imageUrl', 'deliveryAvailable', 'pickupOnly', 'deliveryCoverage', 'updatedAt',
            'isArchived', 'archivedAt', 'priceFlag'
          ])) ||
        (isBuyer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) &&
          request.resource.data.get('viewCount', 0) == resource.data.get('viewCount', 0) + 1) ||
        (isBuyer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'lastOrderId']) &&
          request.resource.data.get('quantity', 0) < resource.data.get('quantity', 0) &&
          canReserveProductStock(productId));
      allow delete: if isApprovedFarmer() && request.auth.uid == resource.data.farmerId;
    }

    // ---- Users ----
    match /users/{userId} {
      // Private account records contain email, contact and moderation data.
      // Other marketplace users must use the allow-listed publicProfiles view.
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      // Client registration may create only a normal Buyer or pending Farmer.
      // Admin records must be provisioned out-of-band with the Admin SDK.
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['buyer', 'farmer'] &&
        request.resource.data.approvalStatus == (request.resource.data.role == 'buyer' ? 'approved' : 'pending') &&
        request.resource.data.isVerified == (request.resource.data.role == 'buyer') &&
        request.resource.data.get('accountStatus', 'active') == 'active' &&
        !request.resource.data.keys().hasAny([
          'reviewedBy', 'reviewedAt', 'suspensionReason', 'suspendedUntil',
          'banReason', 'moderationUpdatedBy', 'moderationUpdatedAt',
          'emailVerified', 'emailVerifiedAt', 'emailOtpVerifiedAt'
        ]) &&
        // emailOtpVerified may only be claimed once the code check passed.
        (!('emailOtpVerified' in request.resource.data) ||
          (request.resource.data.emailOtpVerified == true && emailOtpVerified(userId)));
      // A user may only edit their own profile fields — approvalStatus,
      // role, and the admin-review audit trail (reviewedBy/reviewedAt) must
      // all stay exactly as they were, so a Farmer account cannot bypass
      // verification by writing approvalStatus == 'approved' (or forging
      // who/when "reviewed" it) directly from the client. Only an admin
      // account may change any of those four fields.
      // Same reasoning extends to moderation/account-status fields: a
      // suspended or banned farmer must not be able to clear that state (or
      // its supporting fields) by writing their own profile — only an admin
      // account may change any of them.
      allow update: if request.auth != null && (
        (request.auth.uid == userId &&
          request.resource.data.approvalStatus == resource.data.approvalStatus &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('isVerified', null) == resource.data.get('isVerified', null) &&
          request.resource.data.get('authProvider', null) == resource.data.get('authProvider', null) &&
          request.resource.data.get('emailVerified', null) == resource.data.get('emailVerified', null) &&
          request.resource.data.get('emailVerifiedAt', null) == resource.data.get('emailVerifiedAt', null) &&
          request.resource.data.get('emailOtpVerified', null) == resource.data.get('emailOtpVerified', null) &&
          request.resource.data.get('emailOtpVerifiedAt', null) == resource.data.get('emailOtpVerifiedAt', null) &&
          request.resource.data.get('rating', null) == resource.data.get('rating', null) &&
          request.resource.data.get('reviewCount', null) == resource.data.get('reviewCount', null) &&
          request.resource.data.get('trustedBuyer', null) == resource.data.get('trustedBuyer', null) &&
          request.resource.data.get('trustedBuyerReviewCount', null) == resource.data.get('trustedBuyerReviewCount', null) &&
          request.resource.data.get('identityVerified', null) == resource.data.get('identityVerified', null) &&
          request.resource.data.get('identityVerifiedBy', null) == resource.data.get('identityVerifiedBy', null) &&
          request.resource.data.get('identityVerifiedAt', null) == resource.data.get('identityVerifiedAt', null) &&
          request.resource.data.get('reviewedBy', null) == resource.data.get('reviewedBy', null) &&
          request.resource.data.get('reviewedAt', null) == resource.data.get('reviewedAt', null) &&
          request.resource.data.get('accountStatus', null) == resource.data.get('accountStatus', null) &&
          request.resource.data.get('suspendedUntil', null) == resource.data.get('suspendedUntil', null) &&
          request.resource.data.get('suspensionReason', null) == resource.data.get('suspensionReason', null) &&
          request.resource.data.get('banReason', null) == resource.data.get('banReason', null) &&
          request.resource.data.get('moderationUpdatedBy', null) == resource.data.get('moderationUpdatedBy', null) &&
          request.resource.data.get('moderationUpdatedAt', null) == resource.data.get('moderationUpdatedAt', null)) ||
        isAdmin()
      );

      // Exact GPS coordinates only — never barangay/municipality/province,
      // which stay on the doc above (public, needed for marketplace
      // display). The doc above is readable by any signed-in user, so an
      // exact pin can never live there; only the account's own owner or an
      // admin (who already has full moderation access to users/{}) may
      // read this. Buyers never get a farmer's exact pin this way — the
      // marketplace map instead reads /barangayClusters (a server-computed,
      // PII-free average), and the order-flow reveal reads a snapshot
      // Cloud Functions copies onto the order doc once confirmed (see
      // functions/index.js's notifyOrderStatusChange and
      // recomputeBarangayCluster).
      match /private/{privateDocId} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          isAdmin()
        );
        allow write: if request.auth != null && request.auth.uid == userId &&
          (isBuyer() || isApprovedFarmer());
      }

      // A buyer's bookmarked listings (see saved_products_service.dart):
      // just the product id and when it was saved. Private to the account.
      match /savedProducts/{productId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if isBuyer() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['productId', 'savedAt']) &&
          request.resource.data.productId == productId &&
          request.resource.data.savedAt == request.time;
      }

      // Devices (app installations) this account has signed in on — see
      // device_trust_service.dart. The doc id is a hash of an id the app
      // generated for itself; no hardware identifier is stored. Only the
      // account's own signed-in user can read or write its list (an admin
      // may read). Creating one is what makes the onNewTrustedDevice Cloud
      // Function send the New Device Login Alert; its own bookkeeping
      // fields (alertStatus…) are written with the Admin SDK and can't be
      // set or changed from a client.
      match /trustedDevices/{deviceId} {
        allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly([
            'deviceIdHash', 'platform', 'deviceName', 'appVersion',
            'trusted', 'firstSeenAt', 'lastSeenAt'
          ]) &&
          request.resource.data.deviceIdHash == deviceId &&
          deviceId.size() == 64 &&
          request.resource.data.trusted == true &&
          request.resource.data.platform is string &&
          request.resource.data.platform.size() <= 40 &&
          request.resource.data.deviceName is string &&
          request.resource.data.deviceName.size() <= 120 &&
          request.resource.data.firstSeenAt == request.time &&
          request.resource.data.lastSeenAt == request.time;
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSeenAt', 'appVersion']) &&
          request.resource.data.lastSeenAt == request.time;
        // The user removing a device from their own list.
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }

    // Collection-group counterpart of users/{uid}/private above. A
    // fixed-path match only secures direct subcollection access
    // (users/{uid}/private/geo) — Firestore requires this separate
    // {path=**} rule before a collectionGroup('private') query is
    // authorized at all, which is how the admin Demand Heatmap reads
    // every buyer's exact pin at once (see dashboard_analytics_service.dart
    // / admin_dashboard_screen.dart). Admin-only: the owner's own doc is
    // already covered by the nested rule above.
    match /{path=**}/private/{privateDocId} {
      allow read: if isAdmin();
    }

    // "Active now" status for the green dot in Messages (see
    // presence_service.dart). Each account writes only its own doc, and
    // only the two presence fields; any marketplace user may read it.
    match /presence/{userId} {
      allow read: if marketplaceUser();
      allow create, update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['online', 'lastSeen']) &&
        request.resource.data.online is bool &&
        request.resource.data.lastSeen == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Public, minimal profile projection maintained by a trusted Function.
    // No client writes and no email, phone, precise location or moderation data.
    match /publicProfiles/{userId} {
      allow read: if marketplaceUser();
      allow write: if false;
    }

    // ---- Barangay farmer-density clusters (aggregated, PII-free) ----
    // One averaged point + a farmer count per barangay, written only by
    // recomputeBarangayCluster in Cloud Functions (Admin SDK bypasses these
    // rules) — never which specific farmers contribute to it. This is what
    // the buyer marketplace map reads instead of any individual farmer's
    // exact coordinates.
    match /barangayClusters/{barangay} {
      allow read: if marketplaceUser();
      allow write: if false;
    }

    // ---- Verification documents ----
    // A farmer may create/update their own submission, but the resulting
    // `status` must be 'pending' — only an admin can ever set it to
    // 'approved'/'rejected'. This is what actually blocks a farmer from
    // self-approving via a direct write here (users/{uid} above is also
    // locked, but this collection needs its own guard since it carries its
    // own, separate status field — see docs/firestore-schema-migration.md).
    match /verificationDocs/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        isAdmin()
      );
      allow create, update: if request.auth != null && (
        (request.auth.uid == userId &&
          get(userPath(userId)).data.role == 'farmer' &&
          request.resource.data.status == 'pending') ||
        isAdmin()
      );
      allow delete: if request.auth != null &&
        isAdmin();
    }

    // ---- Conversations & messages ----
    // Chat is between one buyer and one farmer — never buyer to buyer or
    // farmer to farmer.
    function buyerAndFarmer(participants) {
      let other = participants[0] == request.auth.uid ? participants[1] : participants[0];
      let mine = get(userPath(request.auth.uid)).data.role;
      let theirs = get(userPath(other)).data.role;
      return (mine == 'buyer' && theirs == 'farmer') ||
        (mine == 'farmer' && theirs == 'buyer');
    }

    // For reading a chat's messages / typing / read state. A conversation
    // document only exists once a first message has been sent (opening a
    // chat creates nothing), so a chat that is still an unsent draft has
    // no document: its subcollections are empty and may be listened to —
    // there is nothing in them, and nothing can be written to them until
    // the conversation exists (every write rule below still requires it).
    function mayReadThread(conversationId) {
      let path = /databases/$(database)/documents/conversations/$(conversationId);
      return !exists(path) || request.auth.uid in get(path).data.participants;
    }

    match /conversations/{conversationId} {
      allow read: if marketplaceUser() && (
        resource == null ||
        request.auth.uid in resource.data.participants
      );

      allow create: if marketplaceUser() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        buyerAndFarmer(request.resource.data.participants);

      allow update: if marketplaceUser() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTime', 'participantNames', 'unreadCount', 'lastSenderId',
          'farmerId', 'farmerName', 'productId', 'productName', 'productImageUrl',
          'productPrice', 'unit', 'deliveryAvailable', 'pickupOnly', 'farmerImage',
          'retailPrice', 'wholesalePrice', 'wholesaleMinimumQuantity', 'retailMaximumQuantity',
          'hasMessages'
        ]);

      match /messages/{messageId} {
        allow read: if marketplaceUser() && mayReadThread(conversationId);
        // A 'receipt' message (the receipt card of a completed order) is
        // normally written by the issueOrderReceipt Cloud Function. A client
        // may only add it as the seller of that completed order, to the
        // conversation with that order's buyer, under the one id reserved
        // for it — so nobody can post a made-up receipt card.
        allow create: if marketplaceUser() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          (request.resource.data.get('type', '') != 'receipt' || (
            request.resource.data.orderId is string &&
            messageId == 'receipt_' + request.resource.data.orderId &&
            get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.auth.uid &&
            get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'completed' &&
            get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId in
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          ));
        allow update: if marketplaceUser() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.get('likes', {}).diff(resource.data.get('likes', {}))
            .affectedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.get('likes', {}).get(request.auth.uid, false) is bool;
      }

      match /typing/{uid} {
        allow read: if marketplaceUser() && mayReadThread(conversationId);
        allow create, update: if marketplaceUser() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.keys().hasOnly(['isTyping', 'updatedAt']) &&
          request.resource.data.isTyping is bool &&
          request.resource.data.updatedAt is timestamp;
      }

      match /reads/{uid} {
        allow read: if marketplaceUser() && mayReadThread(conversationId);
        allow create, update: if marketplaceUser() && request.auth.uid == uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.keys().hasOnly(['lastReadAt']) &&
          request.resource.data.lastReadAt is timestamp;
      }
    }

    // ---- Orders ----
    match /orders/{orderId} {
      allow create: if isBuyer()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && approvedFarmer(request.resource.data.sellerId)
        && request.resource.data.status == 'pending'
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.productId is string
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.farmerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.get('isArchived', false) == false
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.get('isSuspended', false) == false
        && getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.lastOrderId == orderId
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.quantity -
          getAfter(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.quantity == request.resource.data.quantity;

      allow read: if marketplaceUser()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        );

      // Buyer can edit details while pending.
      allow update: if isBuyer()
        && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == resource.data.status
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'buyerName', 'buyerContact', 'buyerAddress', 'deliveryMethod', 'neededBy', 'updatedAt'
        ]);

      // Buyer can only attach review markers after completion.
      allow update: if isBuyer()
        && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'completed'
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewedAt', 'reviewRating'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['reviewedAt', 'reviewRating'])
        && existsAfter(/databases/$(database)/documents/productReviews/$(orderId))
        && getAfter(/databases/$(database)/documents/productReviews/$(orderId)).data.buyerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/productReviews/$(orderId)).data.orderId == orderId
        && getAfter(/databases/$(database)/documents/productReviews/$(orderId)).data.productId == resource.data.productId
        && getAfter(/databases/$(database)/documents/productReviews/$(orderId)).data.rating == request.resource.data.reviewRating;

      // Seller controls status transitions.
      allow update: if isApprovedFarmer()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'completedAt'])
        && (
          (resource.data.status == 'pending' &&
            (request.resource.data.status == 'confirmed' || request.resource.data.status == 'rejected'))
          ||
          (resource.data.status == 'confirmed' && request.resource.data.status == 'shipped')
          ||
          (resource.data.status == 'shipped' && request.resource.data.status == 'completed')
        );

      // ---- Delay / reschedule (confirmed orders only) ----
      // The same order throughout: none of these may touch its buyer,
      // seller, product, quantity or prices.

      // Seller reports a delay and proposes a new date. Status stays
      // 'confirmed'.
      allow update: if isApprovedFarmer()
        && resource.data.sellerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delay', 'updatedAt'])
        && request.resource.data.delay.keys().hasOnly(['reason', 'note', 'proposedDate', 'reportedAt', 'status'])
        && request.resource.data.delay.reason in ['weather', 'transport', 'supply', 'other']
        && request.resource.data.delay.proposedDate is timestamp
        && request.resource.data.delay.reportedAt == request.time
        && request.resource.data.delay.status == 'proposed'
        && request.resource.data.delay.note is string
        && request.resource.data.delay.note.size() <= 200;

      // Buyer accepts the proposed date: it becomes the confirmed
      // fulfillment date, and nothing else about the proposal may change.
      allow update: if isBuyer()
        && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && resource.data.delay.status == 'proposed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delay', 'confirmedFulfillmentDate', 'updatedAt'])
        && request.resource.data.delay.status == 'accepted'
        && request.resource.data.delay.diff(resource.data.delay).affectedKeys().hasOnly(['status'])
        && request.resource.data.confirmedFulfillmentDate == resource.data.delay.proposedDate;

      // Buyer cancels instead of accepting the new date. Only possible
      // while a proposed date is waiting for their answer; the reserved
      // stock is returned by the handleOrderReschedule Cloud Function.
      allow update: if isBuyer()
        && resource.data.buyerId == request.auth.uid
        && resource.data.status == 'confirmed'
        && resource.data.delay.status == 'proposed'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'updatedAt'])
        && request.resource.data.cancelReason == 'delay'
        && request.resource.data.cancelledAt == request.time;

      allow delete: if false;

      // ---- Order contact numbers ----
      // orders/{orderId}/private/buyer and .../private/farmer each hold
      // one mobile number for this order ({contact, updatedAt}), kept off
      // the order document so the other side cannot read it early.
      //   - Each side always reads its own.
      //   - The other side reads it only while the order is confirmed or
      //     shipped: not while pending, and not after it is completed,
      //     rejected or cancelled.
      //   - The buyer sets theirs while the order is still pending; the
      //     farmer sets theirs from confirmation onwards.
      // No collection-group rule exists for 'private', so these can never
      // be listed across orders.
      match /private/{side} {
        function contactOrder() {
          return get(/databases/$(database)/documents/orders/$(orderId)).data;
        }
        function contactShared() {
          return contactOrder().status in ['confirmed', 'shipped'];
        }
        function validContact() {
          return request.resource.data.keys().hasOnly(['contact', 'updatedAt'])
            && request.resource.data.contact is string
            && request.resource.data.contact.matches('[+]639[0-9]{9}');
        }

        allow get: if marketplaceUser() && (
          (side == 'buyer' && (
            contactOrder().buyerId == request.auth.uid ||
            (contactOrder().sellerId == request.auth.uid && contactShared())
          )) ||
          (side == 'farmer' && (
            contactOrder().sellerId == request.auth.uid ||
            (contactOrder().buyerId == request.auth.uid && contactShared())
          )) ||
          (side in ['buyer', 'farmer'] && isAdmin())
        );
        allow list: if false;

        allow create, update: if marketplaceUser() && validContact() && (
          (side == 'buyer' &&
            contactOrder().buyerId == request.auth.uid &&
            contactOrder().status == 'pending') ||
          (side == 'farmer' &&
            contactOrder().sellerId == request.auth.uid &&
            contactOrder().status in ['pending', 'confirmed', 'shipped'])
        );
        allow delete: if false;
      }
    }

    // ---- Transaction receipts — one per completed order (doc id ==
    // orderId), written only by issueOrderReceipt in Cloud Functions (Admin
    // SDK bypasses these rules). A frozen copy of the transaction values:
    // the order's farmer and buyer can read it, nobody can edit it. ----
    match /receipts/{orderId} {
      allow read: if marketplaceUser() && (
        resource == null ||
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    // ---- Market sales (platform-wide, anonymized) — written only by
    // recordMarketSale in Cloud Functions (Admin SDK bypasses these
    // rules) whenever an order's status becomes 'completed'. Holds just
    // {productName, quantity, createdAt}, never buyer/seller identity,
    // so it's safe for any signed-in user to read for the Market tab's
    // seasonal/demand insights — unlike orders/{}, which must stay
    // restricted to that order's own buyer/seller/admin. ----
    match /market_sales/{saleId} {
      allow read: if marketplaceUser();
      allow write: if false;
    }

    // ---- Product reviews ----
    match /productReviews/{reviewId} {
      allow read: if true;

      // Buyer can create one review doc per completed order (reviewId == orderId).
      allow create: if isBuyer()
        && request.resource.data.buyerId == request.auth.uid
        && reviewId == request.resource.data.orderId
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 0.5
        && request.resource.data.rating <= 5
        && (request.resource.data.rating * 2) % 1 == 0
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.productId == request.resource.data.productId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.sellerId == request.resource.data.sellerId
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'completed';

      allow update: if isBuyer() &&
        resource.data.buyerId == request.auth.uid &&
        resource.data.orderId == reviewId &&
        request.resource.data.buyerId == resource.data.buyerId &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.productId == resource.data.productId &&
        request.resource.data.sellerId == resource.data.sellerId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'imageUrl']) &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 0.5 &&
        request.resource.data.rating <= 5 &&
        (request.resource.data.rating * 2) % 1 == 0 &&
        get(/databases/$(database)/documents/orders/$(reviewId)).data.buyerId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(reviewId)).data.status == 'completed';
      allow update: if isApprovedFarmer() &&
        resource.data.sellerId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sellerReply', 'sellerReplyAt'
        ]) &&
        request.resource.data.sellerReply is string &&
        request.resource.data.sellerReply.size() > 0 &&
        request.resource.data.sellerReply.size() <= 500;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'moderationStatus', 'moderatedBy', 'moderatedAt'
        ]) &&
        request.resource.data.moderationStatus == 'removed' &&
        request.resource.data.moderatedBy == request.auth.uid;
      allow delete: if false;
    }

    // ---- Moderation reports (flagged listings / users) ----
    match /reports/{reportId} {
      // Admins see every report (Moderation Queue); anyone else may read
      // only the reports they filed themselves (Messages → Reported).
      allow read: if request.auth != null && (
        isAdmin() ||
        resource.data.reporterId == request.auth.uid
      );

      allow create: if marketplaceUser() &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.keys().hasOnly([
          'issueType', 'description', 'reporterId', 'reporterName',
          'reportedUserId', 'reportedUserName', 'targetType', 'farmerId',
          'productId', 'productName', 'reviewId', 'conversationId', 'status', 'createdAt'
        ]) &&
        (request.resource.data.get('targetType', '') != 'review' || (
          request.resource.data.get('reviewId', '') is string &&
          request.resource.data.reviewId.size() > 0 &&
          exists(/databases/$(database)/documents/productReviews/$(request.resource.data.reviewId)) &&
          get(/databases/$(database)/documents/productReviews/$(request.resource.data.reviewId)).data.productId == request.resource.data.productId &&
          get(/databases/$(database)/documents/productReviews/$(request.resource.data.reviewId)).data.sellerId == request.resource.data.farmerId &&
          get(/databases/$(database)/documents/productReviews/$(request.resource.data.reviewId)).data.buyerId == request.resource.data.reportedUserId &&
          request.auth.uid != request.resource.data.reportedUserId
        ));

      allow update, delete: if request.auth != null &&
        isAdmin();

      // Append-only moderation audit trail — an admin-confirmed decision on
      // this report is never edited or removed after the fact, only added to.
      match /history/{entryId} {
        allow read: if request.auth != null &&
          isAdmin();
        allow create: if request.auth != null &&
          isAdmin() &&
          request.resource.data.adminId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- Confirmed violations ----
    // Written when an Admin confirms a violation on a report (Moderation
    // Queue): tied to the reported account by uid (reportedUserId) and to
    // the report it came from (sourceReportId, also the document's id, so
    // one report can never yield two). Admin-only, and never rewritten or
    // removed afterwards.
    match /violations/{violationId} {
      allow read: if request.auth != null &&
        isAdmin();
      allow create: if request.auth != null &&
        isAdmin() &&
        request.resource.data.sourceReportId == violationId &&
        request.resource.data.confirmedBy == request.auth.uid &&
        request.resource.data.reportedUserId is string &&
        request.resource.data.reportedUserId.size() > 0;
      allow update, delete: if false;
    }

    // ---- Support requests (buyer/farmer -> admin) ----
    match /supportRequests/{requestId} {
      // The requester can read back their own submitted requests; an admin
      // can read all of them to (eventually) triage/respond.
      allow read: if marketplaceUser() &&
        (resource.data.userId == request.auth.uid ||
         isAdmin());

      allow create: if marketplaceUser() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.keys().hasOnly([
          'userId', 'userName', 'userEmail', 'subject', 'message', 'status', 'createdAt'
        ]);

      // Only an admin marks a request resolved/in-progress — the requester
      // can't edit their own request after sending it.
      allow update: if request.auth != null &&
        isAdmin();

      allow delete: if false;
    }

    // ---- Historical monthly demand, imported by an Admin from a
    // spreadsheet (Admin → Market Forecasts). Forecasting support only:
    // kept apart from orders/market_sales, and Admin-only both ways. ----
    match /historical_demand/{recordId} {
      allow read, write: if request.auth != null &&
        isAdmin();
    }

    // ---- Admin-managed baseline commodity prices ----
    // The Admin Portal's single active session (functions/admin_session.js
    // writes it, through the Admin SDK). An Admin can read only their own
    // record, and change nothing in it except to say the session is still
    // open; nobody else has any access.
    match /adminSessions/{adminUid} {
      allow read: if request.auth != null &&
        request.auth.uid == adminUid &&
        isAdmin();
      allow update: if request.auth != null &&
        request.auth.uid == adminUid &&
        isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastActiveAt']);
      allow create, delete: if false;

      match /history/{sessionId} {
        allow read: if request.auth != null &&
          request.auth.uid == adminUid &&
          isAdmin();
        allow write: if false;
      }
    }

    // ---- Admin Portal Help & Support FAQ (lib/services/admin_faq.dart) ----
    // Read by the portal's Help & Support and its Support Assistant, and
    // edited in FAQ Management — by an active Admin only. Nobody else can
    // read or change it.
    match /adminFaqs/{faqId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          'category', 'question', 'answer', 'keywords', 'published',
          'needsReview', 'order', 'createdAt', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.category in [
          'account', 'users', 'listings', 'transactions', 'pricing',
          'security', 'maintenance', 'general'
        ] &&
        request.resource.data.question is string &&
        request.resource.data.question.size() > 0 &&
        request.resource.data.question.size() <= 300 &&
        request.resource.data.answer is string &&
        request.resource.data.answer.size() > 0 &&
        request.resource.data.answer.size() <= 4000 &&
        request.resource.data.keywords is list &&
        request.resource.data.keywords.size() <= 30 &&
        request.resource.data.published is bool &&
        request.resource.data.needsReview is bool &&
        request.resource.data.order is int &&
        request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /market_prices/{commodityId} {
      allow read: if true;
      allow write: if request.auth != null &&
        isAdmin();

      // One dated entry per reference price the office has set (Admin →
      // Price Management). Admin-only both ways.
      match /history/{entryId} {
        allow read, write: if request.auth != null &&
          isAdmin();
      }
    }

    // ---- In-app notification history, written by Cloud Functions
    // (Admin SDK bypasses these rules) — clients may only read their own
    // and toggle `read` on their own; nothing else about a notification
    // (title, body, type, data, recipient) is client-editable, so no one
    // can rewrite their own history or impersonate a system notification. ----
    match /notifications/{uid}/items/{itemId} {
      allow read: if marketplaceUser() && request.auth.uid == uid;
      allow update: if marketplaceUser() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read is bool;
      allow create, delete: if false;
    }

    // ---- Buyer search activity (feeds the admin demand heatmap and the
    // buyer-facing "Trending Searches" row — query text isn't sensitive,
    // so any signed-in user can read it, not just admins) ----
    match /searchEvents/{eventId} {
      allow create: if isBuyer() &&
        request.resource.data.userId == request.auth.uid;
      allow read: if marketplaceUser();
      allow update, delete: if false;
    }

    // ---- Trending Searches — anonymous per-day counts per search term,
    // written only by the aggregateSearchTrend Cloud Function (Admin SDK
    // bypasses these rules). Holds the term and its counts, never who
    // searched; the per-buyer markers that function uses to count each
    // buyer once (searchTrendVotes) are not readable by anyone. ----
    match /searchTrends/{termId} {
      allow read: if marketplaceUser();
      allow write: if false;
    }
    match /searchTrendVotes/{voteId} {
      allow read, write: if false;
    }

    // ---- Announcements: a message from the Admin to farmers, or to
    // farmers and buyers (a maintenance notice). The Admin creates one;
    // the sendAnnouncement Cloud Function delivers it to each recipient's
    // own notifications, which is where they read it. Never edited or
    // deleted from a client, so what was sent stays on record. ----
    match /announcements/{announcementId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 80 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 600 &&
        request.resource.data.kind in ['announcement', 'maintenance'] &&
        request.resource.data.audience in ['farmers', 'all'];
      allow update, delete: if false;
    }

    // ---- Admin Portal audit log — written only by the logAuditEvent
    // Cloud Function (Admin SDK bypasses these rules), never by a client
    // directly. This is what makes it tamper-proof: even an admin account
    // cannot edit or delete an entry, or forge one for another admin,
    // since there is no client write path into this collection at all. ----
    match /audit_logs/{logId} {
      allow read: if request.auth != null &&
        isAdmin();
      allow write: if false;
    }
  }
}
