{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22"
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "agritrade-bef87",
          "appId": "1:333409993687:android:a18324ec288fc026554192",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "agritrade-bef87",
          "configurations": {
            "android": "1:333409993687:android:a18324ec288fc026554192",
            "ios": "1:333409993687:ios:e436b1433d1b5251554192",
            "macos": "1:333409993687:ios:e436b1433d1b5251554192",
            "web": "1:333409993687:web:04793729931ec56c554192",
            "windows": "1:333409993687:web:258dc08a033cee77554192"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/reset-password/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/reset-password",
        "destination": "/reset-password/index.html"
      },
      {
        "source": "/product/**",
        "function": {
          "functionId": "productPage",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/.well-known/assetlinks.json",
        "destination": "/assetlinks.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
